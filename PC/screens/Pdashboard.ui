  <property name="styleSheet">
   <string notr="true">
QWidget { font-family: "Segoe UI", "Malgun Gothic", sans-serif; font-size: 12px; color: #e3e6ee; }
QWidget#DashboardWidget, QScrollArea#contentScroll, QWidget#dashboardContent { background: #0d0f13; border: none; }
QFrame#sidebar { background: #191a1f; border: none; border-right: 1px solid #2c2e37; }
QLabel#sidebarLogo { color: #ff3e5b; font-size: 20px; font-weight: 700; }
QLabel#sidebarName { color: #f4f4f6; font-family: "Bahnschrift", "Segoe UI"; font-size: 18px; font-weight: 600; }
QLabel#sidebarEdition, QLabel#sidebarSection { color: #949ba9; font-size: 9px; }
QPushButton[role="nav"] { background: transparent; color: #b9bdc7; border: 1px solid transparent; border-left: 3px solid transparent; border-radius: 0; text-align: left; padding: 12px 8px; }
QPushButton[role="nav"]:hover { background: #24262e; color: #f2f3f7; }
QPushButton[role="nav"][active="true"] { background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 #41212b, stop: 1 #211c24); border-left: 3px solid #ff334f; color: #fff0f4; font-weight: 600; }
QPushButton#sidebarBluetoothButton { background: #242029; border: 1px solid #65303f; color: #ff96a8; border-radius: 3px; padding: 10px 5px; }
QPushButton#sidebarBluetoothButton:hover { background: #39232e; border-color: #d74460; }
QFrame#sidebarPreview { background: #14161c; border: 1px solid #343743; border-radius: 3px; }
QLabel#sidebarPreviewTitle { color: #c6cbd6; font-weight: 600; }
QLabel#sidebarPreviewNote { color: #959dab; font-size: 10px; }
QPushButton[role="disconnect"] { background: #241820; color: #ff8ba0; border: 1px solid #773447; border-radius: 3px; padding: 6px 5px; font-size: 11px; }
QPushButton[role="disconnect"]:hover { background: #3b202c; border-color: #ff526b; color: #fff0f4; }
QPushButton[role="disconnect"]:focus { border-color: #ff9bac; }
QPushButton#returnToLoginButton { background: transparent; color: #a2aab9; border: 1px solid transparent; text-align: left; padding: 10px 0; }
QPushButton#returnToLoginButton:hover { color: #ff8599; }
QLabel#dashboardTitle { color: #f5f5f7; font-family: "Bahnschrift", "Segoe UI"; font-size: 29px; font-weight: 700; }
QLabel#dashboardSubtitle { color: #a0a8b6; font-size: 12px; }
QLabel#previewBadge { background: #28231b; color: #edc780; border: 1px solid #594933; border-radius: 3px; padding: 6px 10px; font-size: 11px; }
QFrame[kind="panel"], QFrame[kind="metric"] { background: #171a21; border: 1px solid #323640; border-radius: 4px; }
QFrame#chartPanel { background: #13161c; border-top: 2px solid #ff334f; }
QFrame#fanControlPanel { background: #181a22; border-top: 2px solid #59c7f8; }
QFrame#fanCard { border-bottom: 2px solid #ff334f; }
QLabel[role="title"] { font-size: 14px; font-weight: 600; color: #e1e5ee; }
QLabel[role="muted"] { color: #a2abba; font-size: 11px; }
QLabel[role="metricValue"] { color: #f0f2f8; font-family: "Bahnschrift", "Segoe UI"; font-size: 32px; font-weight: 600; }
QLabel#fanValue { color: #ff637d; }
QLabel[role="metricUnit"] { color: #a6aebc; font-size: 12px; padding-top: 14px; }
QLabel[role="metricTag"] { color: #929dac; font-size: 10px; }
QLabel[role="metricIcon"] { font-size: 15px; color: #ff7088; background: #39232e; border-radius: 3px; }
QLabel#temperatureIcon { color: #f4bf80; background: #342921; }
QLabel#humidityIcon { color: #6ed1fa; background: #1d2f40; }
QLabel#clientIcon { color: #bca4f6; background: #2b243b; }
QLineEdit, QSpinBox, QComboBox { background: #0f1218; color: #e6e9f1; border: 1px solid #3c414e; border-radius: 3px; padding: 7px 9px; selection-background-color: #a6233b; selection-color: #ffffff; }
QLineEdit:hover, QSpinBox:hover, QComboBox:hover { border-color: #656d7f; }
QLineEdit:focus, QSpinBox:focus, QComboBox:focus { border: 1px solid #ff526b; background: #171a22; }
QComboBox::drop-down { border: none; width: 20px; }
QPushButton[role="primary"] { background: #d92946; color: #ffffff; border: 1px solid #ff536e; border-radius: 3px; padding: 10px 15px; font-weight: 600; }
QPushButton[role="primary"]:hover { background: #f13755; border-color: #ff8a9e; }
QPushButton[role="primary"]:pressed { background: #a91e35; }
QPushButton[role="secondary"] { background: #30212b; color: #ff97ab; border: 1px solid #703344; border-radius: 3px; padding: 8px 11px; }
QPushButton[role="secondary"]:hover { background: #442632; border-color: #cf4965; }
QPushButton[role="rowAction"] { background: #30212b; color: #ff9caf; border: 1px solid #703344; border-radius: 2px; padding: 2px 8px; font-size: 11px; }
QPushButton[role="rowAction"]:hover { background: #442632; border-color: #cf4965; }
QPushButton[role="subtle"] { background: #232833; color: #bac7d9; border: 1px solid #414b5d; border-radius: 3px; padding: 8px 11px; }
QPushButton[role="subtle"]:hover { background: #30394a; color: #e7f2ff; }
QPushButton[role="preset"] { background: #11151d; color: #aeb7c8; border: 1px solid #394354; border-radius: 3px; padding: 6px; }
QPushButton[role="preset"]:hover { background: #263244; border-color: #59c7f8; color: #96deff; }
QPushButton:focus { border-color: #ff7c94; }
QLabel#actualLegend { color: #ff6a83; font-size: 10px; }
QLabel#targetLegend { color: #75d1f8; font-size: 10px; }
QLabel#targetValue { color: #7ad4fa; font-family: "Bahnschrift", "Segoe UI"; font-size: 26px; font-weight: 600; }
QLabel#fanDeviceLabel { background: #0f1218; color: #bdc8d8; border: 1px solid #3c414e; border-radius: 3px; padding: 7px 9px; }
QSlider::groove:horizontal { height: 5px; background: #333b49; border-radius: 0; }
QSlider::sub-page:horizontal { background: #49bcea; border-radius: 0; }
QSlider::handle:horizontal { width: 12px; margin: -6px 0; border: 1px solid #a1e6ff; background: #59c7f8; border-radius: 1px; }
QSlider::handle:horizontal:hover { background: #b9ecff; }
QTableWidget { background: #15181e; alternate-background-color: #1b1f27; color: #d4dae6; border: 1px solid #303540; gridline-color: #303540; selection-background-color: #482432; selection-color: #fff0f4; outline: 0; }
QHeaderView::section { background: #232832; color: #adb9cb; border: none; border-bottom: 1px solid #424958; padding: 7px 9px; font-size: 10px; text-align: left; }
QTableWidget::item { padding: 8px; border: none; }
QLabel#dashboardFeedback { color: #a7b3c6; font-size: 11px; padding: 2px; }
QScrollBar:vertical { border: none; background: #15181e; width: 7px; margin: 0; }
QScrollBar::handle:vertical { background: #485264; border-radius: 1px; min-height: 28px; }
QScrollBar::handle:vertical:hover { background: #bc3c57; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QToolTip { background: #23262e; color: #f0f1f5; border: 1px solid #4a4f5c; padding: 5px; }

QLabel#serverEndpoint { color: #9acde5; font-size: 11px; }
</string>
