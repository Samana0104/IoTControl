  <property name="windowTitle">
   <string>IoT Control — 서버 연결</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
QWidget { font-family: "Segoe UI", "Malgun Gothic", sans-serif; font-size: 13px; color: #e6e8ee; }
QMainWindow, QWidget#centralwidget, QStackedWidget#pageStack { background: #0b0d11; }
QFrame#loginCard { background: #16181e; border: 1px solid #30333c; border-radius: 5px; }
QFrame#brandPanel {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1, stop: 0 #1b171e, stop: 0.55 #12151a, stop: 1 #101319);
    border: none; border-right: 1px solid #30333c; border-radius: 3px;
}
QLabel#brandMark { background: #ff334f; border-radius: 3px; color: #ffffff; font-size: 18px; font-weight: 700; }
QLabel#brandName { color: #f7f7f9; font-family: "Bahnschrift", "Segoe UI"; font-size: 20px; font-weight: 600; }
QLabel#brandEdition { color: #9b9ea8; font-size: 9px; }
QLabel#heroTitle { color: #f5f5f7; font-size: 32px; font-weight: 700; }
QLabel#heroDescription { color: #b5b9c4; font-size: 14px; }
QPushButton#featureMonitor, QPushButton#featureControl, QPushButton#featureConnect {
    background: #1d2028; border: 1px solid #363a46; border-radius: 3px;
    color: #bfc4d0; font-size: 11px; padding: 5px 10px;
}
QPushButton#featureMonitor:hover, QPushButton#featureControl:hover, QPushButton#featureConnect:hover {
    background: #30212a; border-color: #a03b4e; color: #fff0f3;
}
QPushButton#featureMonitor:checked, QPushButton#featureControl:checked, QPushButton#featureConnect:checked {
    background: #40202b; border-color: #ff334f; color: #ff98aa;
}
QPushButton#featureMonitor:focus, QPushButton#featureControl:focus, QPushButton#featureConnect:focus {
    border-color: #ff526b;
}
QLabel#brandFooter { color: #8d93a0; font-size: 10px; }
QWidget#formPanel { background: transparent; }
QLabel#accessLabel, QLabel#serverAccessLabel { color: #ff637b; font-family: "Bahnschrift", "Segoe UI"; font-size: 11px; font-weight: 600; }
QLabel#loginTitle, QLabel#serverTitle { font-size: 27px; font-weight: 700; color: #f4f4f7; }
QLabel#loginSubtitle, QLabel#serverSubtitle { color: #a0a6b3; font-size: 13px; }
QLabel#usernameLabel, QLabel#passwordLabel, QLabel#serverHostLabel, QLabel#serverPortLabel { color: #cbd0da; font-weight: 600; }
QLineEdit#usernameInput, QLineEdit#serverHostInput, QLineEdit#serverPortInput {
    background: #101217; border: 1px solid #363a45; border-radius: 3px;
    padding: 0 14px; color: #f0f1f5; selection-background-color: #a6233b; selection-color: #ffffff;
}
QLineEdit#usernameInput:hover, QLineEdit#serverHostInput:hover, QLineEdit#serverPortInput:hover { border-color: #636978; }
QLineEdit#usernameInput:focus, QLineEdit#serverHostInput:focus, QLineEdit#serverPortInput:focus { border: 2px solid #ff334f; padding: 0 13px; background: #14161d; }
QLineEdit#usernameInput[invalid="true"], QLineEdit#serverHostInput[invalid="true"], QLineEdit#serverPortInput[invalid="true"] { border: 2px solid #ff7b89; padding: 0 13px; }
QFrame#passwordField { background: #101217; border: 1px solid #363a45; border-radius: 3px; }
QFrame#passwordField:hover { border-color: #636978; }
QFrame#passwordField[focused="true"] { border: 2px solid #ff334f; background: #14161d; }
QFrame#passwordField[invalid="true"] { border: 2px solid #ff7b89; }
QLineEdit#passwordInput {
    background: transparent; border: none; padding: 0 2px; color: #f0f1f5;
    selection-background-color: #a6233b; selection-color: #ffffff;
}
QToolButton#passwordToggleButton {
    background: transparent; border: none; border-radius: 3px; color: #a0a6b3; font-size: 12px; padding: 5px;
}
QToolButton#passwordToggleButton:hover { background: #33212b; color: #ff8296; }
QToolButton#passwordToggleButton:focus { border: 1px solid #ff526b; }
QCheckBox#rememberUsername { color: #a7adba; font-size: 12px; spacing: 8px; }
QCheckBox#rememberUsername::indicator { width: 14px; height: 14px; background: #101217; border: 1px solid #596171; border-radius: 2px; }
QCheckBox#rememberUsername::indicator:hover { border-color: #ff8296; }
QCheckBox#rememberUsername::indicator:checked { background: #ff334f; border-color: #ff8fa3; }
QCheckBox#rememberUsername:focus { color: #ff8296; }
QLabel#feedbackLabel { color: #ff8296; font-size: 12px; }
QLabel#feedbackLabel[messageType="info"] { color: #b2b8c5; }
QPushButton#loginButton, QPushButton#connectServerButton {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 #d82441, stop: 1 #f03551);
    border: 1px solid #ff526b; border-radius: 3px; color: #ffffff;
    font-size: 15px; font-weight: 700; padding: 12px;
}
QPushButton#loginButton:hover, QPushButton#connectServerButton:hover { background: #ff3f5c; border-color: #ff8da0; }
QPushButton#loginButton:pressed, QPushButton#connectServerButton:pressed { background: #b71f39; border-color: #d93852; }
QPushButton#loginButton:focus, QPushButton#connectServerButton:focus { border: 2px solid #ff9bac; }
QPushButton#previewDashboardButton {
    background: transparent; color: #a2adbd; border: 1px solid transparent; border-radius: 3px;
    font-size: 12px; padding: 8px;
}
QPushButton#previewDashboardButton:hover { color: #f3f4f7; background: #242831; }
QPushButton#previewDashboardButton:focus { border-color: #59c7f8; }
QFrame#helpDivider { background: #2b2f39; border: none; }
QLabel#helpTitle { color: #b1b7c3; font-size: 12px; }
QLabel#helpDescription { color: #8e95a3; font-size: 12px; }
QLabel#formFooter { color: #828a99; font-size: 10px; }
QToolTip { background: #23262e; color: #f0f1f5; border: 1px solid #4a4f5c; padding: 5px; }

QWidget#serverPage, QWidget#loginPage, QStackedWidget#accessStack { background: transparent; border: none; }
QLabel#serverSteps { color: #9eabba; font-family: "Bahnschrift", "Segoe UI"; font-size: 10px; padding: 10px 8px; background: #10141c; border: 1px solid #333a48; border-left: 2px solid #ff334f; }
QLabel#serverFeedback { color: #ff8296; font-size: 12px; }
QLabel#serverPreviewNote { color: #d1b077; font-size: 11px; }
QLabel#serverFooter { color: #828a99; font-size: 10px; }
QLabel#loginServerSummary { color: #9acde5; font-size: 11px; }
QPushButton#changeServerButton { background: transparent; color: #9eabba; border: 1px solid #384353; border-radius: 3px; padding: 6px 8px; font-size: 11px; }
QPushButton#changeServerButton:hover { color: #ff96a8; border-color: #ff526b; }
QPushButton#changeServerButton:focus { border-color: #59c7f8; }
QPushButton#loginButton:disabled, QPushButton#previewDashboardButton:disabled { color: #777c88; background: #262932; border-color: #363a45; }
</string>
