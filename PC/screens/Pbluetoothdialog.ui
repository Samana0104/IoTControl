  <property name="styleSheet">
   <string notr="true">
QDialog#BluetoothDialog { background: #17191f; }
QWidget { font-family: "Segoe UI", "Malgun Gothic", sans-serif; font-size: 13px; color: #e0e4ed; }
QLabel#bluetoothTitle { font-size: 23px; font-weight: 700; color: #f5f5f8; }
QLabel#bluetoothSubtitle, QLabel#bluetoothHint { font-size: 12px; color: #a7afbe; }
QLabel#bluetoothPreviewBadge { background: #2e251c; color: #edc780; border: 1px solid #594933; border-radius: 3px; padding: 5px 8px; font-size: 10px; }
QLabel[role="field"] { font-size: 12px; font-weight: 600; }
QLineEdit { background: #101217; color: #f0f1f5; border: 1px solid #3d424e; border-radius: 3px; padding: 10px 12px; selection-background-color: #a6233b; selection-color: #ffffff; }
QLineEdit:focus { border: 1px solid #ff526b; background: #171a22; }
QLineEdit[invalid="true"] { border-color: #ff8296; }
QToolButton#bluetoothPasswordToggle { background: #262a34; color: #c4cede; border: 1px solid #454e5f; border-radius: 3px; padding: 8px; }
QToolButton#bluetoothPasswordToggle:hover { background: #39232e; color: #ff96a8; border-color: #ac3b53; }
QToolButton#bluetoothPasswordToggle:focus { border-color: #ff7c94; }
QLabel#bluetoothFeedback { color: #ff8296; font-size: 12px; }
QPushButton#bluetoothRequestButton { background: #d92946; color: #ffffff; border: 1px solid #ff536e; border-radius: 3px; padding: 12px; font-weight: 600; }
QPushButton#bluetoothRequestButton:hover { background: #f13755; }
QPushButton#bluetoothCancelButton { background: #262a34; color: #b9c2d2; border: 1px solid #454e5f; border-radius: 3px; padding: 12px; }
QPushButton#bluetoothCancelButton:hover { background: #343b4a; color: #eef4ff; }
QPushButton:focus { border-color: #ff7c94; }
</string>
