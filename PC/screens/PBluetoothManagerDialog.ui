  <property name="styleSheet">
   <string notr="true">QDialog#BluetoothManagerDialog { background: #101219; }
QWidget { font-family: "Segoe UI", "Malgun Gothic"; font-size: 13px; color: #e4eaf5; }
QLabel { background: transparent; }
QLabel#managerTitle { font-size: 25px; font-weight: 700; color: #ffffff; }
QLabel#managerSubtitle, QLabel#managerNote { color: #909eb3; font-size: 12px; }
QLabel#managerBadge { background: #301c29; color: #ff6b88; border: 1px solid #703047; border-radius: 4px; padding: 7px 12px; font-size: 11px; font-weight: 600; }
QLabel#managerFeedback { background: #172331; color: #91dbf7; border: 1px solid #29475d; border-left: 3px solid #55bfe8; border-radius: 4px; padding: 12px 14px; }
QPushButton { background: #1c2230; color: #e8effc; border: 1px solid #3b475d; border-radius: 5px; padding: 12px 18px; font-weight: 600; }
QPushButton:hover { background: #263347; border-color: #67cbf1; }
QPushButton:pressed { background: #121c2b; }
QPushButton:focus { border-color: #88daf8; }
QPushButton#scanBluetoothButton { background: #142632; color: #9ee5ff; border-color: #367b97; }
QPushButton#scanBluetoothButton:hover { background: #1d3b4d; border-color: #70d3f8; }
QPushButton#connectAllBluetoothButton { background: #cc224b; color: #ffffff; border-color: #f4416b; }
QPushButton#connectAllBluetoothButton:hover { background: #e42b57; border-color: #ff7998; }
QPushButton#connectAllBluetoothButton:pressed { background: #a2193b; }
QPushButton:disabled { background: #171c26; color: #667489; border-color: #303847; }
QTableWidget { background: #141923; alternate-background-color: #191f2b; color: #e6efff; border: 1px solid #303b4e; border-radius: 5px; selection-background-color: #273f56; selection-color: #ffffff; }
QTableWidget::item { padding: 9px; border-bottom: 1px solid #252f40; }
QTableWidget::item:selected { background: #273f56; color: #ffffff; }
QHeaderView { background: #202938; }
QHeaderView::section { background: #202938; color: #a7bcd6; border: 0; border-bottom: 1px solid #3b4d64; padding: 12px 9px; font-weight: 600; }
QTableCornerButton::section { background: #202938; border: 0; }
QScrollBar:vertical { background: #111722; width: 9px; margin: 0; }
QScrollBar::handle:vertical { background: #3d526c; border-radius: 4px; min-height: 24px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: #111722; }
QScrollBar:horizontal { background: #111722; height: 9px; margin: 0; }
QScrollBar::handle:horizontal { background: #3d526c; border-radius: 4px; min-width: 24px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: #111722; }
</string>
