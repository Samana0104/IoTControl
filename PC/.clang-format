BasedOnStyle: LLVM

# Put opening braces on the following line (Allman style).
BreakBeforeBraces: Allman

# Indent with four spaces; do not emit tab characters.
IndentWidth: 4
ContinuationIndentWidth: 4
TabWidth: 4
UseTab: Never

# Keep declarations, calls, and expressions on one line regardless of length.
ColumnLimit: 0
BreakStringLiterals: false
