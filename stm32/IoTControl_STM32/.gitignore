# Build directories
/build/
/Debug/
/Release/
/RelWithDebInfo/
/MinSizeRel/
/cmake-build-*/

# CMake generated files (when configured in the source tree)
/CMakeCache.txt
/CMakeFiles/
/cmake_install.cmake
/Makefile
/compile_commands.json
/build.ninja
/.ninja_deps
/.ninja_log

# STM32 build artifacts
*.o
*.obj
*.d
*.a
*.elf
*.axf
*.hex
*.bin
*.map
*.list
*.lst
*.su
*.cyclo
*.siz

# STM32CubeMX / STM32CubeIDE generated local metadata
/.mxproject
/mx.scratch/
/.settings/
/.metadata/
/.project
/.cproject
*.launch

# Local editor configuration and caches
/.vscode/
/.clangd
/.cache/
.clang-format-cache

# Temporary and backup files
*.log
*.tmp
*.temp
*.bak
*.orig
*.swp
*.swo
*~

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini
